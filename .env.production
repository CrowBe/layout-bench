# Public deployed origins. Loaded only for production builds (`vite build`),
# after `.env`, so these override the localhost defaults. `npm run dev` does
# not load this file.
#
# These are public URLs, not secrets. vite.config.ts writes them into
# dist/_headers, and the studio bundle reads VITE_SUPPLIER_ORIGIN to find the
# partner frame.

VITE_STUDIO_ORIGIN=https://alza-dev.pages.dev
VITE_SUPPLIER_ORIGIN=https://alza-dev.netlify.app
