{
  "name": "reno-layouts",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Floor-plan studio for the WebMCP Challenge. Draw in 2D, walk it in 3D, and let an AI agent co-edit the same live page through WebMCP tools.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "plugin:pack": "mkdir -p dist && cd plugins/reno-layouts && python3 -m zipfile -c ../../dist/reno-layouts-plugin.zip .codex-plugin skills",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node tests/run-e2e.mjs",
    "stage-pack": "vite-node --script scripts/stage-pack.ts",
    "sample-sheets": "vite-node --script scripts/sample-sheets.ts",
    "printables": "vite-node --script scripts/printables.ts",
    "print-3d": "vite-node --script scripts/print-3d.ts",
    "partner": "vite --port 5200 --strictPort",
    "deploy:studio": "wrangler pages deploy dist --project-name alza-dev --branch main",
    "deploy:partner": "npx netlify deploy --prod --dir dist"
  },
  "dependencies": {
    "pdfjs-dist": "^5.7.284",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.178.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.178.0",
    "@vitejs/plugin-react": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-node": "3.2.4",
    "vitest": "^3.2.0"
  }
}
